+
+static ssize_t panel_sleep_store(struct device *dev,
+				 struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(dev);
+	struct nt36672a_panel *pinfo = mipi_dsi_get_drvdata(dsi);
+	bool sleep;
+	int ret;
+
+	(void)attr;
+	ret = kstrtobool(buf, &sleep);
+	if (ret)
+		return ret;
+	if (sleep == pinfo->asleep)
+		return count;
+	if (sleep)
+		ret = mipi_dsi_dcs_set_display_off(dsi);
+	else
+		ret = mipi_dsi_dcs_set_display_on(dsi);
+	if (ret < 0)
+		return ret;
+	pinfo->asleep = sleep;
+	return count;
+}
+
+static DEVICE_ATTR_RW(panel_sleep);
+
 static int nt36672a_panel_get_modes(struct drm_panel *panel,
 				    struct drm_connector *connector)
 {
@@ -763,6 +804,10 @@ static int nt36672a_panel_probe(struct mipi_dsi_device *dsi)
 		return err;
 	}
 
+	err = device_create_file(&dsi->dev, &dev_attr_panel_sleep);
+	if (err)
+		dev_warn(&dsi->dev, "panel_sleep sysfs failed: %d\n", err);
+
 	return 0;
 }
 
@@ -771,6 +816,8 @@ static void nt36672a_panel_remove(struct mipi_dsi_device *dsi)
 	struct nt36672a_panel *pinfo = mipi_dsi_get_drvdata(dsi);
