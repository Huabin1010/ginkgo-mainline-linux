[Unit]
Description=Start ginkgo MPSS (needed for WCN3990 WiFi)
After=sysinit.target tqftpserv.service rmtfs.service
Wants=tqftpserv.service rmtfs.service
Before=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/ginkgo-start-mpss.sh
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
