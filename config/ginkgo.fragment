# Ginkgo (SM6125) kernel config fragment — phase 1 boot focus.
# Applied on top of arm64 defconfig via merge_config.sh

# Kryo 260 (A73/A53) has no FEAT_LVA — 52-bit VA from arm64 defconfig will not boot
# CONFIG_ARM64_VA_BITS_52 is not set
# CONFIG_ARM64_VA_BITS_48 is not set
CONFIG_ARM64_VA_BITS_39=y
CONFIG_ARM64_VA_BITS=39

# Serial console (primary debug path)
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7

# Storage / rootfs (eMMC SDHCI needs ARM SMMU for apps_smmu)
CONFIG_ARM_SMMU=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_EXT4_FS=y

# USB (adb / networking later)
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_USB=y

# DRM/MDSS/DSI — Tianma NT36672A 1080×2340 panel
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_MDSS=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_14NM_PHY=y
CONFIG_DRM_MSM_KMS=y
CONFIG_DRM_MSM_KMS_FBDEV=y
# Panel Kconfig depends on BACKLIGHT_CLASS_DEVICE; defconfig has it =m which forces panel =m
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_GPIO=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_BACKLIGHT_KTD3136=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_REGMAP_SPMI=y
CONFIG_QCOM_PBS=y
# CONFIG_LEDS_QCOM_LPG_MODULE is not set
CONFIG_LEDS_QCOM_LPG=y
CONFIG_DRM_PANEL_NOVATEK_NT36672A=y
CONFIG_DRM_PANEL_HUAXING_FT8719=y
CONFIG_DRM_MIPI_DSI=y

# Framebuffer console (mirror serial boot log on screen via DRM fbdev).
# Requires console=tty0 in boot.img cmdline (see scripts/build-bootimg.sh).
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
CONFIG_FB=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_GPIO=y

# WiFi: WCN3990 via ath10k SNOC (2.4 GHz + 5 GHz). Built-in so we do not
# need to deploy modules onto the live userdata rootfs.
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_REMOTEPROC=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QCOM_PIL_INFO=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_ATH10K=y
CONFIG_ATH10K_SNOC=y
# WCN36XX is WCN3660/3680 (Prima), not WCN3990 — leave off.

CONFIG_REGULATOR_QPNP_LCDB=y

# Qualcomm platform — SM6125 clocks are REQUIRED to boot
CONFIG_ARCH_QCOM=y
CONFIG_MAILBOX=y
CONFIG_QCOM_APCS_IPC=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_QCOM_RPMPD=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_RPM=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_QCOM_GENI_SE=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_TOUCHSCREEN_NT36XXX_SPI=y
CONFIG_EXTRA_FIRMWARE="novatek_ts_tianma_fw.bin"
# CONFIG_EXTRA_FIRMWARE_DIR is injected by scripts/build-kernel.sh
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_SM6125=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_SM_GCC_6125=y
CONFIG_SM_GPUCC_6125=y
CONFIG_SM_DISPCC_6125=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM6115=y
CONFIG_QCOM_ICC_BWMON=y

# Kryo 260 OSM (same HW as SM6115). Without this, CPUs stay at the
# bootloader vote: gold can be slower than silver, so GNOME feels stuck.
CONFIG_ARM_QCOM_CPUFREQ_HW=y

# TSENS v2 @ 0x4411000 — Resources only shows temp for type "cpu-thermal".
CONFIG_NVMEM=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_QCOM_TSENS=y

# Debug
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_MAGIC_SYSRQ=y

# Reboot to fastboot: msm ps-hold + PMIC PON reboot mode (mode-bootloader in pm6125.dtsi)
CONFIG_POWER_RESET_MSM=y
CONFIG_POWER_RESET_QCOM_PON=y

# PMI632 QG LAST_ADC → /sys/class/power_supply/qcom-battery
CONFIG_POWER_SUPPLY=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_BATTERY_QCOM_PMI632_QG=y

# PM6125 power key + volume-down (resin). The pwrkey reboot notifier
# sets PON_PS_HOLD reset type to SHUTDOWN (4) on poweroff. Without this,
# msm-poweroff only drops PS_HOLD as a reset, so Ubuntu "关机" boots again.
# Volume-up is gpio-keys on PM6125 GPIO5 (downstream trinket-idp).
CONFIG_INPUT_MISC=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y

# Docker / containers. This board ships no /lib/modules, so everything
# Docker needs must be built-in (=y). Covers Moby check-config.sh
# "Generally Necessary" plus the Optional features Docker Engine uses
# (overlay2, bridge/NAT, iptables-nft, userns, encrypted overlay).
CONFIG_IPV6=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_CT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_REDIR=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_IP_SCTP=y
CONFIG_IP_VS=y
CONFIG_IP_VS_IPV6=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_OVERLAY_FS=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_VXLAN=y
CONFIG_IPVLAN=y
CONFIG_MACVLAN=y
CONFIG_DUMMY=y
CONFIG_CRYPTO_SEQIV=y
CONFIG_XFRM_USER=y
CONFIG_INET_ESP=y
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_CONNTRACK_TFTP=y
CONFIG_NF_NAT_FTP=y
CONFIG_NF_NAT_TFTP=y
